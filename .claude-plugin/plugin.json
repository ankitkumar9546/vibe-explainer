{
  "name": "vibe-explainer",
  "version": "0.1.0",
  "description": "Records what Claude Code does in your project and explains it like a teacher: timeline, diff in plain words, claims checked against evidence, impact, quiz. Ask it what changed yesterday (MCP). Everything stays on your machine.",
  "author": {
    "name": "Ankit Kumar"
  },
  "homepage": "https://github.com/ankitkumar9546/vibe-explainer",
  "repository": "https://github.com/ankitkumar9546/vibe-explainer",
  "license": "MIT",
  "keywords": [
    "learning",
    "explain",
    "diff",
    "teacher",
    "beginner",
    "hinglish"
  ],
  "hooks": "./plugin/hooks/hooks.json",
  "commands": "./plugin/commands",
  "skills": "./plugin/skills",
  "mcpServers": {
    "vibe-explainer": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/packages/mcp/bin/vibe-explainer-mcp.js"
      ]
    }
  }
}
