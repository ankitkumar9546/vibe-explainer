{
  "name": "vibe-explainer-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "vibe-explainer-monorepo",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@vibe-explainer/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/vibe-explainer": {
      "resolved": "packages/cli",
      "link": true
    },
    "packages/cli": {
      "name": "vibe-explainer",
      "version": "0.0.0",
      "dependencies": {
        "@vibe-explainer/core": "0.0.0"
      },
      "bin": {
        "vibe-explainer": "bin/vibe-explainer.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/core": {
      "name": "@vibe-explainer/core",
      "version": "0.0.0",
      "engines": {
        "node": ">=20"
      }
    }
  }
}
